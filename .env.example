# Modelo de configuração. NÃO guarde segredo aqui: este arquivo vai para
# o Git. O arquivo real é o .env, que está no .gitignore.
#
# Você normalmente NÃO precisa criar o .env à mão: o ./iniciar.sh
# (ou iniciar.bat) gera um na primeira execução, com uma senha aleatória
# de 24 caracteres.
#
# Para criar manualmente:
#     cp .env.example .env
# e troque a senha abaixo por uma sua. O compose recusa subir sem ela.

# --- Banco ---------------------------------------------------------
POSTGRES_USER=bbam
# Obrigatória, sem valor padrão. Use algo longo e aleatório, por exemplo:
#     openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=bbam
# A porta é publicada só em 127.0.0.1 — o banco não fica exposto na rede.
POSTGRES_PORT=5432

# --- Portas --------------------------------------------------------
API_PORT=8000
WEB_PORT=8080

# --- API -----------------------------------------------------------
# Origens liberadas no CORS, separadas por vírgula. O padrão é o
# localhost do compose. Em produção, ponha o endereço real do site.
# Evite "*": libera qualquer página da web a chamar esta API.
CORS_ORIGINS=http://localhost:8080

# Requisições por minuto, por IP, no endpoint de escrita.
RATE_LIMIT=30
