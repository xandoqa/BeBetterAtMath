# Copie para .env e ajuste se precisar:
#     cp .env.example .env
#
# Todos têm valor padrão no docker-compose.yml, então o projeto sobe sem
# .env nenhum. Este arquivo existe para quando você quiser mudar algo.

# --- Banco ---------------------------------------------------------
POSTGRES_USER=bbam
POSTGRES_PASSWORD=bbam
POSTGRES_DB=bbam
POSTGRES_PORT=5432

# --- Portas --------------------------------------------------------
API_PORT=8000
WEB_PORT=8080

# --- API -----------------------------------------------------------
# Origens liberadas no CORS, separadas por vírgula.
# Em produção, troque o * pelo endereço real do site.
CORS_ORIGINS=*
