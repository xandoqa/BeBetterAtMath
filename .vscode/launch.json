{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Abrir o site (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "servidor local",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${workspaceFolder}/src/*"
      }
    },
    {
      "name": "Abrir o site (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "servidor local",
      "sourceMaps": true
    },
    {
      "name": "Jogar no terminal (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/bbam.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Testes (Python)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tools",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "API do placar (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "POSTGRES_HOST": "localhost"
      }
    }
  ]
}
