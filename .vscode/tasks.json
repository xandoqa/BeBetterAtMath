{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "servidor local",
      "type": "shell",
      "command": "python3 tools/serve.py --porta 8000",
      "windows": { "command": "python tools/serve.py --porta 8000" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Servindo",
          "endsPattern": "Ctrl-C para parar"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "compilar TypeScript",
      "type": "shell",
      "command": "npm run build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "compilar e observar",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "testes",
      "type": "shell",
      "command": "python3 -m unittest discover -s tools -v",
      "windows": { "command": "python -m unittest discover -s tools -v" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always" }
    },
    {
      "label": "subir tudo (Docker)",
      "type": "shell",
      "command": "./iniciar.sh",
      "windows": { "command": "iniciar.bat" },
      "presentation": { "reveal": "always" }
    },
    {
      "label": "desligar tudo (Docker)",
      "type": "shell",
      "command": "./parar.sh",
      "windows": { "command": "parar.bat" },
      "presentation": { "reveal": "always" }
    }
  ]
}
