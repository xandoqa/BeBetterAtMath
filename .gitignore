# Dependências
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Variáveis de ambiente — NUNCA versionar: o .env guarda a senha do banco.
# Só o .env.example, sem segredo nenhum, fica no repositório.
.env
.env.*
!.env.example

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp

# Sistema operacional
.DS_Store
Thumbs.db

# Registros locais
*.log
npm-debug.log*
.bebetteratmath.json

# Nota: assets/js/ NÃO é ignorado de propósito.
# O build compilado fica versionado para que o GitHub Pages
# sirva o site sem precisar de etapa de compilação.
